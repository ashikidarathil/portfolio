# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio

# Admin login. Generate both values with: npm run hash-password -- "your-password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Cloudinary (Dashboard > API Keys) for image and resume uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Your live domain, used for SEO tags and the sitemap
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
